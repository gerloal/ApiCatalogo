{
  "ServiceName": "api-catalogo",
  "SourceConfiguration": {
    "AutoDeploymentsEnabled": false,
    "AuthenticationConfiguration": {
      "AccessRoleArn": "arn:aws:iam::340663646958:role/AppRunnerECRAccessRole"
    },
    "ImageRepository": {
      "ImageRepositoryType": "ECR",
      "ImageIdentifier": "340663646958.dkr.ecr.eu-west-1.amazonaws.com/mi-api-catalogo:prod-1",
      "ImageConfiguration": {
        "Port": "8080",
        "RuntimeEnvironmentVariables": {
          "UPLOADS_BUCKET": "catalog-uploads-340663646958",
          "UPLOADS_QUEUE_URL": "https://sqs.eu-west-1.amazonaws.com/340663646958/catalog-jobs"
        }
      }
    }
  },
  "InstanceConfiguration": {
    "Cpu": "1 vCPU",
    "Memory": "2 GB",
    "InstanceRoleArn": "arn:aws:iam::340663646958:role/AppRunnerRuntimeRole"
  },
  "HealthCheckConfiguration": {
    "Protocol": "HTTP",
    "Path": "/health",
    "Interval": 10,
    "Timeout": 5,
    "HealthyThreshold": 1,
    "UnhealthyThreshold": 5
  }
}

